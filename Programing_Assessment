# Function to view damaged artefacts
def view_damaged_artefacts():
    print("\n===== DAMAGED ARTEFACTS =====")

    found = False

    for artefact in artefacts:
        if artefact[5].lower() == "damaged":
            print("----------------------------")
            print("Artefact ID:", artefact[0])
