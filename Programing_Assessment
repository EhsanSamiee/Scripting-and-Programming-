# Main function
def main():
    while True:
        clear_screen()
        display_menu()

        choice = input("\nEnter your choice (1-10): ")

        if choice == "1":
            add_artefact()

        elif choice == "2":
            view_all_artefacts()

        elif choice == "3":
            search_artefact()

        elif choice == "4":
            update_artefact()

        elif choice == "5":
            count_total_artefacts()

        elif choice == "6":
            view_available_artefacts()

        elif choice == "7":
            search_by_category()

        elif choice == "8":
            search_by_location()

        elif choice == "9":
            view_damaged_artefacts()

        elif choice == "10":
            print("Thank you for using the LHC Artefact Management System.")
            time.sleep(2)
            sys.exit()

        else:
            print("Invalid choice. Please try again.")
            time.sleep(2)


# Start the program
if __name__ == "__main__":
    main()
