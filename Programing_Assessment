    ["002", "Ancient Vase", "Ceramic", "Traditional ceramic vase", "Room 2", "Available", 2, "1850", "No damage"],
    ["003", "Old Painting", "Artwork", "Landscape painting", "Room 1", "Damaged", 1, "1900", "Small crack"],
    ["004", "Wooden Chair", "Furniture", "Antique wooden chair", "Room 3", "Available", 3, "1880", "Good condition"],
    ["005", "Silver Coin", "Currency", "Old silver coin", "Room 2", "Available", 5, "1750", "Slightly worn"],
    ["006", "Stone Tool", "Historical", "Ancient stone tool", "Room 4", "Damaged", 1, "2000 BC", "Broken edge"],
    ["007", "Old Book", "Document", "Historical book", "Room 3", "Available", 2, "1925", "Good condition"],
