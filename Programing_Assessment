    ["010", "Old Camera", "Equipment", "Vintage camera", "Room 2", "Available", 1, "1960", "Needs cleaning"]
]


# Function to clear the screen
def clear_screen():
    system('cls')


# Function to display the main menu
def display_menu():
    print("\n===== LHC ARTEFACT MANAGEMENT SYSTEM =====")
    print("1. Add New Artefact")
    print("2. View All Artefacts")
    print("3. Search Artefact by Name")
    print("4. Update Artefact")
    print("5. Count Total Artefacts")
    print("6. View Available Artefacts")
    print("7. Search Artefacts by Category")
    print("8. Search Artefacts by Location")
    print("9. View Damaged Artefacts")
    print("10. Exit Program")


# Function to add a new artefact
def add_artefact():
    print("\n===== ADD NEW ARTEFACT =====")

    artefact_id = input("Enter Artefact ID: ")
    name = input("Enter Artefact Name: ")
    category = input("Enter Category: ")
    description = input("Enter Description: ")
    location = input("Enter Display Location: ")
    condition = input("Enter Condition: ")
    quantity = input("Enter Quantity: ")
    year = input("Enter Year: ")
    notes = input("Enter Notes: ")

    artefact = [artefact_id, name, category, description,
                location, condition, quantity, year, notes]

    artefacts.append(artefact)

    print("\nArtefact added successfully!")
    time.sleep(2)


# Function to view all artefacts
def view_all_artefacts():
    print("\n===== ALL ARTEFACTS =====")

    if len(artefacts) == 0:
        print("No artefacts found.")
    else:
        for artefact in artefacts:
            print("----------------------------")
            print("Artefact ID:", artefact[0])
            print("Name:", artefact[1])
            print("Category:", artefact[2])
            print("Description:", artefact[3])
            print("Location:", artefact[4])
            print("Condition:", artefact[5])
            print("Quantity:", artefact[6])
            print("Year:", artefact[7])
            print("Notes:", artefact[8])

    time.sleep(2)


# Function to search artefact by name
def search_artefact():
    print("\n===== SEARCH ARTEFACT =====")

    search_name = input("Enter artefact name to search: ")

    found = False

    for artefact in artefacts:
        if artefact[1].lower() == search_name.lower():
            print("\nArtefact found!")
            print("Artefact ID:", artefact[0])
            print("Name:", artefact[1])
            print("Category:", artefact[2])
            print("Description:", artefact[3])
            print("Location:", artefact[4])
            print("Condition:", artefact[5])
            print("Quantity:", artefact[6])
            print("Year:", artefact[7])
            print("Notes:", artefact[8])
            found = True

    if found == False:
        print("Artefact not found.")

    time.sleep(2)


# Function to update an artefact
def update_artefact():
    print("\n===== UPDATE ARTEFACT =====")

    artefact_id = input("Enter Artefact ID to update: ")

    found = False

    for artefact in artefacts:
        if artefact[0] == artefact_id:
            print("\nArtefact found!")
            print("1. Update Quantity")
            print("2. Update Condition")
            print("3. Update Details")

            choice = input("Enter your choice: ")

            if choice == "1":
                artefact[6] = input("Enter new quantity: ")
                print("Quantity updated successfully!")

            elif choice == "2":
                artefact[5] = input("Enter new condition: ")
                print("Condition updated successfully!")

            elif choice == "3":
                artefact[3] = input("Enter new description: ")
                artefact[8] = input("Enter new notes: ")
                print("Details updated successfully!")

            else:
                print("Invalid choice.")

            found = True
            break

    if found == False:
        print("Artefact not found.")

    time.sleep(2)


# Function to count total artefacts
def count_total_artefacts():
    print("\n===== TOTAL ARTEFACTS =====")

    total = len(artefacts)

    print("Total number of artefacts:", total)

    time.sleep(2)


